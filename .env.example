# Copy to .env for local runs (do not commit). In GitHub Actions, set these as
# repository Secrets instead.

# --- API keys ---------------------------------------------------------------
PERPLEXITY_API_KEY=pplx-...
OPENAI_API_KEY=sk-...

# --- Google Drive delivery --------------------------------------------------
# OAuth (NOT a service account) so uploads land in your own Drive and use your
# quota — service accounts have no Drive storage and 403 on upload. Get these
# three values by running `python oauth_setup.py` once (see README).
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxx
# A folder ID in your My Drive (drive.google.com/drive/folders/<this part>).
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUv

# --- Email delivery (Gmail SMTP) --------------------------------------------
# Use a Gmail App Password (16 chars, no spaces) — NOT your account password.
# Generate at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=arunhari.anand@gmail.com

# Optional
# EMAIL_SUBJECT_PREFIX=Your daily briefing
# PODCAST_BASE_DIR=.
